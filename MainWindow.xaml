<Window x:Class="WpfApp3.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfApp3"
        mc:Ignorable="d"
        Title="飲料點餐系統" Height="570" Width="864">
    <Grid Margin="4,38,16,4" >
        <Grid.RowDefinitions>
            <RowDefinition Height="511.737"/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="641*"/>
            <ColumnDefinition Width="197*"/>
        </Grid.ColumnDefinitions>
        <StackPanel Background="#FFD9B2E2" Margin="10,-12,3,218">
            <StackPanel Height="36" Margin="5,5,5,5" Background="Wheat"
                        Orientation="Horizontal">
                <Label Content="烏瓦紅茶大杯" FontSize="14" VerticalContentAlignment="Center" Margin="20,0,0,0" Height="26" FontWeight="Bold" Foreground="Red" Width="100"/>
                <Label Content="120元" FontSize="14" VerticalContentAlignment="Center" Margin="20,0,0,0" Height="26" FontWeight="Bold" Foreground="Blue" Width="100"/>
                <TextBox FontSize="14" VerticalContentAlignment="Center" Margin="100,0,0,0" Height="26" FontWeight="Bold" Foreground="Blue" Width="100" TextChanged="TextBox_TextChanged"/>
            </StackPanel>
            <StackPanel Height="36" Margin="5,5,5,5" Background="Wheat"
             Orientation="Horizontal">
                <Label Content="烏瓦紅茶小杯" FontSize="14" VerticalContentAlignment="Center" Margin="20,0,0,0" Height="26" FontWeight="Bold" Foreground="Red" Width="100"/>
                <Label Content="80元" FontSize="14" VerticalContentAlignment="Center" Margin="20,0,0,0" Height="26" FontWeight="Bold" Foreground="Blue" Width="100"/>
                <TextBox FontSize="14" VerticalContentAlignment="Center" Margin="100,0,0,0" Height="26" FontWeight="Bold" Foreground="Blue" Width="100"/>
            </StackPanel>
            <StackPanel Height="36" Margin="5,5,5,5" Background="Wheat"
             Orientation="Horizontal">
                <Label Content="綠茶大杯" FontSize="14" VerticalContentAlignment="Center" Margin="20,0,0,0" Height="26" FontWeight="Bold" Foreground="Red" Width="100"/>
                <Label Content="60元" FontSize="14" VerticalContentAlignment="Center" Margin="20,0,0,0" Height="26" FontWeight="Bold" Foreground="Blue" Width="100"/>
                <TextBox FontSize="14" VerticalContentAlignment="Center" Margin="100,0,0,0" Height="26" FontWeight="Bold" Foreground="Blue" Width="100"/>
            </StackPanel>
            <StackPanel Height="36" Margin="5,5,5,5" Background="Wheat"
             Orientation="Horizontal">
                <Label Content="奶茶大杯" FontSize="14" VerticalContentAlignment="Center" Margin="20,0,0,0" Height="26" FontWeight="Bold" Foreground="Red" Width="100"/>
                <Label Content="80元" FontSize="14" VerticalContentAlignment="Center" Margin="20,0,0,0" Height="26" FontWeight="Bold" Foreground="Blue" Width="100"/>
                <TextBox FontSize="14" VerticalContentAlignment="Center" Margin="100,0,0,0" Height="26" FontWeight="Bold" Foreground="Blue" Width="100"/>
            </StackPanel>
            <StackPanel Height="36" Margin="5,5,5,5" Background="Wheat"
             Orientation="Horizontal">
                <Label Content="大禹嶺烏龍茶" FontSize="14" VerticalContentAlignment="Center" Margin="20,0,0,0" Height="26" FontWeight="Bold" Foreground="Red" Width="100"/>
                <Label Content="180元" FontSize="14" VerticalContentAlignment="Center" Margin="20,0,0,0" Height="26" FontWeight="Bold" Foreground="Blue" Width="100"/>
                <TextBox FontSize="14" VerticalContentAlignment="Center" Margin="100,0,0,0" Height="26" FontWeight="Bold" Foreground="Blue" Width="100"/>
            </StackPanel>

        </StackPanel>
        <TextBox HorizontalAlignment="Left" Margin="2,325,0,0" TextWrapping="Wrap" Text="TextBox" VerticalAlignment="Top" Width="841" Height="168" Background="#FFEAE5C2" Grid.ColumnSpan="2" RenderTransformOrigin="0.466,0.154"/>
        <Button Grid.Column="1" Content="OrderButton" HorizontalAlignment="Left" Margin="28,127,0,0" VerticalAlignment="Top" Height="85" Width="126"/>



    </Grid>
</Window>
