<Window
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:av="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" mc:Ignorable="av" x:Class="WpfApp3.MainWindow"
        Title="飲料點餐系統" Height="600" Width="800">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <GroupBox Header="購買方式" Margin="0,0,0,10">
            <StackPanel Orientation="Horizontal">
                <RadioButton x:Name="RadioButton1" Content="內用" Margin="10,0" IsChecked="True" Checked="RadioButton1_Checked"/>
                <RadioButton x:Name="RadioButton2" Content="外帶" Margin="10,0" Checked="RadioButton1_Checked"/>
            </StackPanel>
        </GroupBox>
        <StackPanel x:Name="DrinkMenu_StackPanel" Grid.Row="1" Margin="0,0,0,10">
            <StackPanel Orientation="Horizontal" Margin="0,5">
                <CheckBox Content="紅茶大杯"/>
                <Label Content="60元" Margin="10,0"/>
                <Slider x:Name="slider" Width="100" Minimum="0" Maximum="20" IsSnapToTickEnabled="True"/>
                <Label Content="{Binding Value, ElementName=slider}" Margin="10,0"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,5">
                <CheckBox Content="紅茶中杯"/>
                <Label Content="45元" Margin="10,0"/>
                <Slider x:Name="slider2" Width="100" Minimum="0" Maximum="20" IsSnapToTickEnabled="True"/>
                <Label Content="{Binding Value, ElementName=slider2}" Margin="10,0"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,5">
                <CheckBox Content="綠茶大杯" Height="21"/>
                <Label Content="55元" Margin="10,0"/>
                <Slider x:Name="slider3" Width="100" Minimum="0" Maximum="20" IsSnapToTickEnabled="True"/>
                <Label Content="{Binding Value, ElementName=slider3}" Margin="10,0"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,5">
                <CheckBox Content="綠茶中杯" Height="17"/>
                <Label Content="45元" Margin="10,0" Height="23"/>
                <Slider x:Name="slider4" Width="100" Minimum="0" Maximum="20" IsSnapToTickEnabled="True"/>
                <Label Content="{Binding Value, ElementName=slider4}" Margin="10,0"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal">
                <CheckBox Content="烏龍茶大杯" Height="13"/>
                <Label Content="75元" Margin="10,0"/>
                <Slider x:Name="slider5" Width="100" Minimum="0" Maximum="20" IsSnapToTickEnabled="True"/>
                <Label Content="{Binding Value, ElementName=slider5}" Margin="10,0"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,5">
                <CheckBox Content="烏龍茶中杯" Height="14"/>
                <Label Content="70元" Margin="10,0"/>
                <Slider x:Name="slider6" Width="100" Minimum="0" Maximum="20" IsSnapToTickEnabled="True"/>
                <Label Content="{Binding Value, ElementName=slider6}" Margin="10,0"/>
            </StackPanel>
        </StackPanel>
        <Button x:Name="Orders" Content="訂購" Grid.Row="2" Width="100" Height="40" HorizontalAlignment="Left" Click="OrderButton_Click"/>
        <StackPanel Margin="139,0,119,0" Background="LightSkyBlue" Grid.Row="2"/>
        <TextBlock x:Name="Result_TextBlock" Grid.Row="2" Margin="150,0,30,0" TextWrapping="Wrap" VerticalAlignment="Center" Width="600" Height="166"/>
    </Grid>
</Window>